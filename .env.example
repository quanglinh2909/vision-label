APP_NAME=vision-label
APP_ENV=local
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000

# Chưa chọn database thì app chạy bằng bộ nhớ tạm (mất dữ liệu khi restart).
# Thêm database:  fam install sqlite     (hoặc postgres, mongodb)
# Thêm hàng đợi:  fam install rabbitmq   (hoặc redis, mqtt, kafka)
# Mỗi lệnh vừa cài thư viện, vừa ghi biến vào file này kèm giải thích.
#
# Biến của RIÊNG bạn: thêm thẳng vào đây, rồi khai trong src/core/config.py.
# APP_TEAM_NAME=to-backend
# >>> database (sinh bởi fam env) >>>
# Backend database đang dùng. Xoá dòng này thì app chạy bằng bộ nhớ tạm và mất
# sạch dữ liệu mỗi lần restart.
# BẮT BUỘC — xoá dòng này thì app quay về memory, gần như chắc chắn không phải
# thứ bạn muốn
APP_DB__DRIVER=sqlite
# Đường dẫn file .db. Thư mục chứa nó phải tồn tại — lệnh này tự tạo ./data.
# tuỳ chọn · mặc định: sqlite+aiosqlite:///./data/app.db
APP_DB__DSN=sqlite+aiosqlite:///./data/app.db
# Mức tự chỉnh schema lúc khởi động. off = không đụng gì (dùng cho production
# kèm Alembic) | create = chỉ tạo bảng còn thiếu | sync = thêm cột mới theo
# entity và báo cột thừa (chỉ dev).
# tuỳ chọn · mặc định: create
# sync: tự thêm cột mới khi entity đổi (VD cột giữ chỗ cho nhiều người gán). Lên production thì dùng off + `fam migrate`.
APP_DB__SCHEMA_MODE=sync
# Cho phép sync XOÁ cột không còn trong entity. Xoá cột là mất dữ liệu.
# tuỳ chọn · mặc định: false
APP_DB__DROP_COLUMNS=false
# In câu SQL ra log khi cần soi.
# tuỳ chọn · mặc định: false
APP_DB__ECHO=false
# <<< database <<<

# >>> đăng nhập >>>
# Khoá ký cookie phiên + link tải dataset. Để trống thì tự sinh vào data/secret.key.
# Đổi khoá = đăng xuất mọi người và vô hiệu mọi link tải đã gửi.
APP_AUTH__SECRET=
# Số ngày giữ đăng nhập.
APP_AUTH__SESSION_DAYS=7
# Bật (true) khi public qua HTTPS: cookie chỉ gửi qua kết nối mã hoá.
APP_AUTH__COOKIE_SECURE=false
# <<< đăng nhập <<<

# >>> google drive >>>
# Client ID / secret nhập ở trang Google Drive trong app (menu tài khoản), không đặt ở đây.
# Địa chỉ Google gọi về sau khi cấp quyền. Bỏ trống = tự tính từ địa chỉ đang mở web
# (http://localhost:8000/api/drive/callback). Đặt khi chạy sau tên miền / proxy HTTPS.
APP_DRIVE__REDIRECT_URI=
# Mỗi lần gửi bao nhiêu KB khi upload (bội của 256).
APP_DRIVE__CHUNK_KB=8192
# <<< google drive <<<
